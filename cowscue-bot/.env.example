# Legacy self-hosted WhatsApp bot (whatsapp-web.js). The Twilio webhook in the main app is the
# recommended path; use this only if you can't use Twilio.
# Copy to .env and use the same MongoDB URI and BOT_SECRET_KEY as the root app.
MONGODB_URI=
BOT_SECRET_KEY=

# Base URL of the Cowscue web app the bot posts reports to
COWSCUE_APP_URL=http://localhost:3000

# Optional HTTP health endpoint port (defaults to 3001)
PORT=3001
