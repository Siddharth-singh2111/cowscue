{
  "name": "cowscue",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "loadtest": "node scripts/loadtest.mjs",
    "infra:up": "docker compose up -d --build --scale web=3 --scale worker=2",
    "infra:down": "docker compose down",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.4",
    "@google/generative-ai": "^0.24.1",
    "bullmq": "^6.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.564.0",
    "mongoose": "^9.2.1",
    "motion": "^14.14.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.4.1",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pino-pretty": "^13.2.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.9"
  }
}
