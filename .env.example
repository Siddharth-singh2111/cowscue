# Copy to .env (or .env.local) and fill in credentials.
# Only MONGODB_URI + Clerk are required to boot; every other integration degrades gracefully.

# ── Core ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # public base URL (tunnel URL for local webhooks)
MONGODB_URI=                                         # MongoDB Atlas connection string
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPERADMIN_EMAILS=                                   # comma-separated Clerk emails with admin access

# ── Scaling (optional) ────────────────────────────────────────────────────────
# With Redis: distributed rate limiting, shared cache, and BullMQ background jobs (run `npm run worker`).
# Without Redis: per-process limits/cache and jobs run inline in the web process.
REDIS_URL=                                           # e.g. redis://localhost:6379
QUEUE_MODE=auto                                      # auto | inline
LOG_LEVEL=info
MONGO_POOL_SIZE=10
WORKER_CONCURRENCY=10

# ── Security ──────────────────────────────────────────────────────────────────
DRIVER_LINK_SECRET=                                  # HMAC key for signed driver links (openssl rand -hex 32)
BOT_SECRET_KEY=                                      # shared secret for the legacy cowscue-bot

# ── AI triage (Google Gemini) ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Media (Cloudinary unsigned upload preset) ─────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Realtime (Pusher Channels; enable "client events" off, private channels on) ─
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
NGO_WHATSAPP_NUMBER=                                 # on-call fallback when no NGO covers a location
